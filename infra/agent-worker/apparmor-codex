# AppArmor profile "aibroker-codex" for the agent-worker-codex container ONLY.
#
# Derived from Docker's generated default profile (docker-default): moby/profiles main,
# apparmor/template.go @ a21872828a8e5745d79e2fc1a07ee6dad8aedffa (2026-09-29), rendered with
# profile name "aibroker-codex", daemon profile "unconfined" and ABI 3.0. EVERYTHING below is
# identical to docker-default except the block between the BEGIN/END markers, which REPLACES the
# single line `deny mount,` of docker-default.
#
# Why: bubblewrap (the Codex Linux sandbox) creates its own user+mount namespace and then needs
# to make `/` a slave/private mount, build a new root (tmpfs, bind, proc mounts), pivot_root and
# detach the old root. docker-default's blanket `deny mount,` makes that fail with
# "Failed to make / slave". The rules below allow ONLY those operations; with cap_drop ALL they only
# act inside the user namespace bwrap creates (no CAP_SYS_ADMIN in the initial namespace).
# UNVERIFIED: written statically from bwrap's known mount sequence; the first supervised run may need
# further rules (read the denials in the audit log / dmesg, add the minimum, re-load).
#
# Operator (NOT executed by any code here):
#   sudo apparmor_parser -r -W infra/agent-worker/apparmor-codex     # load / reload
#   sudo aa-status | grep aibroker-codex                              # confirm it is loaded
#   sudo apparmor_parser -R infra/agent-worker/apparmor-codex        # rollback: unload
abi <abi/3.0>,

#include <tunables/global>

profile "aibroker-codex" flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  # Disallow obsolete socket families removed from the Linux kernel.
  # AF_DECnet has no AppArmor family name, so it cannot be denied here.
  deny network ax25,
  deny network ipx,
  deny network appletalk,
  deny network netrom,
  deny network rose,
  deny network econet,
  deny network atmsvc,
  deny network irda,
  deny network wanpipe,
  deny network isdn,
  deny network caif,
  # Disallow AF_ALG (Linux kernel crypto API); see https://copy.fail/
  deny network alg,
  # Disallow AF_VSOCK to prevent host/guest communication.
  deny network vsock,
  capability,
  file,
  umount,
  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  signal (receive) peer=unconfined,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer="aibroker-codex",

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # BEGIN aibroker-codex additions (replaces docker-default's `deny mount,`)
  # propagation changes on / (bwrap: make / a slave, then private)
  mount options=(rw, rslave) -> /,
  mount options=(rw, silent, rslave) -> /,
  mount options=(rw, rprivate) -> /,
  # new root and runtime mounts bwrap builds
  mount fstype=tmpfs,
  mount fstype=proc -> /**,
  mount options=(rw, bind) /** -> /**,
  mount options=(rw, rbind) /** -> /**,
  mount options=(remount, bind, ro) -> /**,
  mount options=(remount, rbind, ro) -> /**,
  mount options=(remount, bind, ro, nosuid, nodev) -> /**,
  mount options=(remount, rbind, ro, nosuid, nodev) -> /**,
  mount fstype=devpts options=(rw, nosuid, noexec) -> /newroot/dev/pts/,
  mount options=(ro, nosuid, nodev, remount, bind, silent, relatime) -> /newroot/,
  mount options=(ro, nosuid, nodev, remount, bind, silent, relatime) -> /newroot/**,
  mount options=(ro, nosuid, nodev, noexec, remount, bind, silent, relatime) -> /newroot/**,
  mount options=(ro, nosuid, nodev, remount, bind, silent) -> /newroot/**,
  mount options=(rw, silent, rprivate) -> /oldroot/,
  pivot_root,
  # END aibroker-codex additions

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other,
  # provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer="aibroker-codex",
}
